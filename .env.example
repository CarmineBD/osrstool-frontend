# Local frontend -> local backend through Vite proxy.
# Copy this file to `.env` when you want to run both apps locally.

# Supabase project used by the frontend for auth.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# In local dev, keep the browser talking to the same origin (`/api`).
# Vite will proxy `/api/*` to `VITE_API_PROXY_TARGET`.
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://localhost:3000

# `true` in local means: use the Vite proxy and avoid browser CORS issues.
# `false` means: call `VITE_API_URL` directly from the browser.
VITE_API_USE_PROXY=true

# Public Discord Feedback Forum URL used by the feedback page.
# Replace both placeholder IDs when the Discord server and forum channel are ready.
VITE_FEEDBACK_DISCORD_FORUM_URL=https://discord.com/channels/REPLACE_SERVER_ID/REPLACE_FEEDBACK_FORUM_CHANNEL_ID

# Optional tuning for React Query live refresh.
# Default refetch interval is 60000 ms when omitted.
VITE_QUERY_REFETCH_INTERVAL_MS=60000

# Optional cache freshness window for dynamic queries.
# If omitted, the app derives a small stale time automatically.
# VITE_QUERY_STALE_TIME_MS=5000

# Public canonical base URL. Set this to the deployment's own URL.
# VITE_SITE_URL=https://www.rsmethods.com

# Set this only in the Vercel TST environment. The build writes it into every
# prerendered document and the client keeps it authoritative while navigating.
# VITE_ROBOTS=noindex, nofollow

# Build-time SEO generation. This server-only variable is used to fetch the
# public methods catalog for sitemap.xml and prerendered method pages.
# SEO_API_URL=https://osrstool-backend-production.up.railway.app
