# Local frontend -> remote TST backend through Vite proxy.
# Copy this file to `.env` when you want to test the frontend locally
# against the deployed TST backend without changing app code.

VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

VITE_API_URL=/api
VITE_API_PROXY_TARGET=https://osrstool-backend-tst.up.railway.app
VITE_API_USE_PROXY=true

VITE_QUERY_REFETCH_INTERVAL_MS=60000
# VITE_QUERY_STALE_TIME_MS=5000
